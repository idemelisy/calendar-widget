# Frontend (Vite) — safe to expose in built JS if using PKCE + localhost redirect
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Backend (Tauri Rust) — required for "Web application" OAuth clients; omit for "Desktop app" clients
GOOGLE_CLIENT_SECRET=your-client-secret

# If your client is "Web application", add this exact Authorized redirect URI in Google Cloud:
# http://127.0.0.1:43123/oauth

# OAuth scopes changed? In Google Cloud add https://www.googleapis.com/auth/calendar.events to the consent screen,
# then in the app use Disconnect and Connect again so the token includes event write access.
