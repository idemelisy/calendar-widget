{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Calendar Widget",
  "version": "0.1.0",
  "identifier": "com.ideme.calendarwidget",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Calendar Widget",
        "width": 380,
        "height": 520,
        "minWidth": 300,
        "minHeight": 380,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "alwaysOnBottom": true,
        "skipTaskbar": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "shell": {
      "open": "^https://.*"
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "calendarwidget"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
